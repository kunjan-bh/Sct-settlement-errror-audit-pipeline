# Local environment configuration — copy to backend/.env and fill in.
# backend/.env is gitignored; this example file is not, so never put a real
# password here.
#
# Precedence for every value below: a value saved on the Settings page wins,
# then this file, then the built-in default. So you can configure entirely
# here and never open the Settings page, or override any single field there.

# --- SMTP (used to send the end-of-batch summary email) --------------------
# Office 365 requires the authenticated account and the From address to be the
# same mailbox, unless that mailbox has been granted SendAs on the other one.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=you@sct.com.np
SMTP_PASSWORD=
SMTP_FROM_EMAIL=you@sct.com.np
# tls (STARTTLS on port 587) | ssl (implicit, use SMTP_PORT=465) | none
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=30

# --- Who the summary goes to, and what it is called ------------------------
MAIL_TO=recipient@sct.com.np
MAIL_CC=
MAIL_FROM_NAME=SCT QR Settlement
MAIL_SUBJECT=QR Transaction Analysis Report – Daily Summary

# --- Signature appended below the body and chart of every summary ----------
# Sending over SMTP bypasses the Outlook client, so the signature configured
# in Outlook is never applied — this is the one that is. Any line left blank
# is skipped rather than rendered empty.
MAIL_SIGNATURE_NAME=
MAIL_SIGNATURE_TITLE=
MAIL_SIGNATURE_COMPANY=Smart Choice Technologies Ltd. (SCT)
MAIL_SIGNATURE_PHONE=
MAIL_SIGNATURE_ADDRESS=5th Floor, RS Sadan, Panipokhari, Kathmandu, Nepal
MAIL_SIGNATURE_TOLL_FREE=1660-0144155
# Optional logo image shown under the signature. Absolute path to a PNG
# or JPG on this machine; embedded inline, not linked. Leave blank for none.
MAIL_SIGNATURE_LOGO=
MAIL_SIGNATURE_WEBSITE=www.sct.com.np

# --- Database --------------------------------------------------------------
# SQLite by default (backend/instance/smartqr.db). Set this to switch, e.g.
# postgresql+psycopg://user:password@localhost:5432/smartqr
# DATABASE_URL=
